# Server
PORT=4001
NODE_ENV=development

# Datenbank (Neon Postgres — eigene Datenbank "rezeptrechner" im bestehenden Projekt)
DATABASE_URL=postgresql://user:pass@host.neon.tech/rezeptrechner?sslmode=require

# JWT
JWT_SECRET=mindestens_32_zeichen_zufall
JWT_EXPIRES_IN=7d

# CORS (kommasepariert: Dev-Client, Test-Site, später teigmaster)
CORS_ORIGIN=http://localhost:5174

# Seed: die 3 Benutzer (gleiche Passwörter wie bisher bei Firebase).
# Nur für "npm run seed" nötig, danach können sie entfernt werden.
SEED_ADMIN_PASSWORD=
SEED_TEIGMACHER_PASSWORD=
SEED_KUCHEN_PASSWORD=

# Für die Firestore-Migration (Phase 2): Admin-Login der alten App
MIGRATION_ADMIN_EMAIL=marten@oetzmann.de
MIGRATION_ADMIN_PASSWORD=

# LMIV-API für externe Apps (Personalplaner): Header X-Api-Key.
# Gleichen Wert in der .env des Personalplaner-Backends hinterlegen.
LMIV_API_KEY=
